# Mismo proyecto de Supabase que ya usa apps/web — copia los mismos valores
# de tu .env actual. El prefijo cambia de VITE_ a NEXT_PUBLIC_ porque así es
# como Next.js expone variables de entorno al navegador (equivalente directo).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# URL pública del sitio, usada para generar sitemap.xml, canonical y Open Graph.
NEXT_PUBLIC_SITE_URL=https://mazoseguros.com

# ── App del admin: notificaciones push y responder por WhatsApp ──
# (van en las variables de entorno de Hostinger; nunca en el código)
# Llaves VAPID de web push. Se generan una sola vez (npx web-push generate-vapid-keys).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mazseguros@hotmail.com
# Secreto que Supabase manda a /api/push/send (el mismo valor va en crm_private_config.push_secret)
PUSH_SECRET=
# service_role key de Supabase: SOLO servidor (rutas /api)
SUPABASE_SERVICE_ROLE_KEY=
# Gupshup (línea de Mazoseguros) para responder desde el CRM
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=573011367055
GUPSHUP_APP_NAME=mazoseguros
# Opcional: solo estos correos pueden responder desde el admin (separados por coma)
ADMIN_EMAILS=

# ── SOAT / modo asesor de BotMazo (ver CRM.md) ──
# Lee las fotos de SOAT con Gemini: crea la key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-flash-latest)
GEMINI_MODEL=
# Opcional: id de una plantilla aprobada en Gupshup para el recordatorio a asesores
# fuera de la ventana de 24 h. Texto sugerido: "Hola, tienes {{1}} SOAT por vencer: {{2}}. Escribe vencen para ver el detalle."
GUPSHUP_TPL_SOAT_ID=
